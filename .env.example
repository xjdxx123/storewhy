# Local service addresses; secrets stay in .env.local.
ZETARIS_BASE_URL='http://localhost:3001'
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Copy the actual URL and Runtime token from the Nightshift Console.
# The NVIDIA key belongs in Nightshift Providers, not in this file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL='nvidia/nemotron-3-ultra-550b-a55b'

# Backend (UI is a separate React project)
PORT=3100
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STOREWHY_MODE=fixture
STOREWHY_DB_PORT=55432
STOREWHY_DB_PASSWORD=
STOREWHY_READER_PASSWORD=
ZETARIS_DOCKER_NETWORK=zetaris_default
